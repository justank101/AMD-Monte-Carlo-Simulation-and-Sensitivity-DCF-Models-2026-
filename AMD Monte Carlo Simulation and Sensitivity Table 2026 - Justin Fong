    "\n",
    "\n",
    "simulations = input('Simulations: ').upper()\n",
    "\n",
    "def monte_carlo_simulation(simulations):\n",
    "    try:\n",
    "    \n",
    "        starting_base_revenue = IS.iloc[0, -1]\n",
    "        \n",
    "        #Lists to use for calculations\n",
