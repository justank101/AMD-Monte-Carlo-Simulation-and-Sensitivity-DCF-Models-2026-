    "    print(f'AMD Historical Revenue: {amd_revenue_historical}')\n",
    "    revenue_mc = amd_revenue_historical.values()\n",
    "    revenue_mc_extracted = np.array([revenue for revenue in revenue_mc])\n",
    "    yoy_growth_revenue = (revenue_mc_extracted[1:] - revenue_mc_extracted[:-1]) / revenue_mc_extracted[:-1]\n",
