    "#Revenue Growth Simulated\n",
    "lower_bound = 0.05 #Revenue cannot go below 5%\n",
    "upper_bound = 0.5 #Revenue cannot go above 50%\n",
    "a = (lower_bound - yoy_revenue_growth_assumption)/std_yoy_growth_revenue\n",
    "\n",
