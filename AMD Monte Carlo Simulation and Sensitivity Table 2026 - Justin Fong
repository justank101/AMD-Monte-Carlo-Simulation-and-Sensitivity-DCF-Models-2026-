    "        \n",
    "        \n",
    "        \n",
    "        np.random.seed(42)\n",
    "        \n",
    "        for i in range(int(simulations)):\n",
    "        \n",
    "            revenue = IS.loc['Operating Revenue'].dropna().tolist()\n",
    "        \n",
    "            cogs = IS.loc['Cost Of Revenue'].dropna().tolist()\n",
    "        \n",
    "            capex = CFS.loc['Capital Expenditure'].dropna().tolist()\n",
    "        \n",
    "            ppe_gross = BS.loc['Gross PPE'].dropna().tolist()\n",
    "        \n",
    "            depreciation_expense = CFS.loc['Depreciation'].dropna().tolist()\n",
    "        \n",
    "            amortization_expense = IS.loc['Amortization'].dropna().tolist()\n",
    "        \n",
    "            sga = IS.loc['Selling General And Administration'].dropna().tolist()\n",
    "        \n",
    "            rnd = IS.loc['Research And Development'].dropna().tolist()\n",
    "        \n",
    "            \n",
    "            #[REVENUE]\n",
    "        \n",
    "            revenue_growth_simulated = truncnorm.rvs(a,b,loc = yoy_revenue_growth_assumption, scale = std_yoy_growth_revenue) #reshaped distribution\n",
    "        \n",
    "        \n",
    "            revenue_monte = starting_base_revenue\n",
    "        \n",
    "        \n",
    "        \n",
    "            for year in range(1, projected_years + 1):\n",
    "        \n",
    "                if year <= 2: #elevated growth for two years Damodaran's \"high growth then linear fade\" model\n",
    "                    decay_rate = 0\n",
    "        \n",
    "                else:\n",
    "                    decay_rate -= decay_rate_assumption\n",
    "        \n",
    "                revenue_growth_simulated_clipped = np.clip(revenue_growth_simulated, 0, 0.5)\n",
    "        \n",
    "                revenue_growth_list.append(revenue_growth_simulated_clipped)#to show mean\n",
    "        \n",
    "                revenue_growth_decayed = (revenue_growth_simulated_clipped - abs(decay_rate))\n",
    "                \n",
    "                revenue_growth_decayed_clipped = np.clip(revenue_growth_decayed, 0, 0.5)#decayed\n",
    "        \n",
    "                revenue_monte *= (1 + revenue_growth_decayed_clipped) #actual revenue\n",
    "        \n",
    "                revenue_growth_simulated_clipped = revenue_growth_decayed\n",
    "        \n",
    "                revenue.append(revenue_monte)\n",
