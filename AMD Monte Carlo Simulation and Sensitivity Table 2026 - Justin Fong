    "#FINDING MEAN AND STD OF REVENUE\n",
    "def revenue_deviation_calculation(IS, historical_years):\n",
    "    # Source: Macrotrends, AMD annual revenue (millions USD), as of 2026-07-13\n",
    "    amd_revenue_historical = {\n",
    "    2015: 3991, 2016: 4319, 2017: 5253, 2018: 6475, 2019: 6731,\n",
